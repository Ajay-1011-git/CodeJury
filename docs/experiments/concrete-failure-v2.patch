+def test_byte_identical_revision_is_refused_but_model_cost_stays_charged(store):
+    from codejury.stage2_core.views import revision
+
+    valid = json.dumps(fixture("repair-draft"))
+    model = FixtureModel([valid, valid])
+    pool = CandidatePool(store, "fixture-run", model, IDENTITIES)
+    parent = pool.generate("fixer_a", pool.views.a, parent=pool.original(), seed=1, cancel=Event())
+    snapshot = store.snapshot("fixture-run")
+    prompt = revision("fixer_a", snapshot["problem"], snapshot["tests"], parent, [])
+    assert (
+        pool.generate("fixer_a", prompt, parent=parent, seed=2, cancel=Event(), revise=True) is None
+    )
+    assert len(model.requests) == 2  # a valid no-op does not receive a schema retry
+    assert len(store.records("fixture-run", "candidates")) == 2
+    usage = store.accounts["fixture-run"].usage()
+    assert usage["learned_candidates"] == 2 and usage["output_tokens"] == 10
+    assert any(
+        "byte-identical" in event["payload"].get("message", "")
+        for event in store.events("fixture-run")
+    )
+
+
+def test_changed_revision_preserves_parent_provenance(store):
+    from codejury.stage2_core.views import revision
+
+    repair = fixture("repair-draft")
+    changed = copy.deepcopy(repair)
+    changed["source"] += "\n# changed source bytes\n"
+    model = FixtureModel([json.dumps(repair), json.dumps(changed)])
+    pool = CandidatePool(store, "fixture-run", model, IDENTITIES)
+    parent = pool.generate("fixer_a", pool.views.a, parent=pool.original(), seed=1, cancel=Event())
+    snapshot = store.snapshot("fixture-run")
+    prompt = revision("fixer_a", snapshot["problem"], snapshot["tests"], parent, [])
+    candidate = pool.generate("fixer_a", prompt, parent=parent, seed=2, cancel=Event(), revise=True)
+    assert candidate["parent_id"] == parent["candidate_id"]
+    assert candidate["source"] == changed["source"]
+    assert candidate["origin"] == "fixer_a_revision"
