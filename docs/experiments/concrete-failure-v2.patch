+def test_revision_promotes_only_registered_failure_and_honest_no_failure_instruction():
+    from codejury.stage2_core.views import revision
+
+    snapshot = json.loads(
+        (REPO_ROOT / "contracts/stage2-fixtures/snapshot-running.json").read_text()
+    )
+    candidate = next(c for c in snapshot["candidates"] if c["candidate_id"] == "c-a")
+    execution = copy.deepcopy(snapshot["executions"][0])
+    execution.update(candidate_id=candidate["candidate_id"], outcome="fail", actual_output=99)
+    text = revision("fixer_a", snapshot["problem"], snapshot["tests"], candidate, [execution])
+    payload = json.loads(text.split("Runtime-visible facts:\n")[1])
+    assert payload["first_failure"]["expected"] == 5
+    assert payload["first_failure"]["actual"] == 99
+    assert "must change behavior" in payload["revision_instruction"]
+    tests = copy.deepcopy(snapshot["tests"])
+    tests[0]["oracle_status"] = "observation_only"
+    # Use the registered observation fixture status without inventing an expectation.
+    tests[0]["oracle_spec"] = {"kind": "observation", "hypothesis": "Compare observed behavior"}
+    text = revision("fixer_a", snapshot["problem"], tests, candidate, [execution])
+    payload = json.loads(text.split("Runtime-visible facts:\n")[1])
+    assert payload["first_failure"] is None
+    assert "No approved concrete execution failure" in payload["revision_instruction"]
